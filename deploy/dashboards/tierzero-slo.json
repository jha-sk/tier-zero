{
  "title": "TierZero SLOs",
  "uid": "tierzero-slo",
  "tags": [
    "tierzero"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "1. Latency (the SLO is a p95, so nothing here is a mean)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Retrieval latency by percentile",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tierzero_stage_duration_seconds_bucket{stage=\"retrieval_total\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tierzero_stage_duration_seconds_bucket{stage=\"retrieval_total\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tierzero_stage_duration_seconds_bucket{stage=\"retrieval_total\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Budget is 25ms p95 for the retrieval span. A mean would hide exactly the tail the SLO is about."
    },
    {
      "type": "timeseries",
      "title": "p95 by stage (which stage to fix)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(tierzero_stage_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "A single end-to-end number says the budget was missed; per-stage histograms say where."
    },
    {
      "type": "row",
      "title": "2. Cost (a distribution, never total spend over request count)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cost per request",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tierzero_request_cost_USD_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tierzero_request_cost_USD_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tierzero_request_cost_USD_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "description": "SLO: p95 <= $0.06 across the whole trace, not per model call."
    },
    {
      "type": "timeseries",
      "title": "Cost p95 by route tier",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route_tier) (rate(tierzero_request_cost_USD_bucket[$__rate_interval])))",
          "legendFormat": "{{route_tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Token mix by billing class",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (token_class) (rate(gen_ai_client_token_usage_token_sum[$__rate_interval]))",
          "legendFormat": "{{token_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Cache reads cost 0.1x input; cache writes carry a premium. Collapsing these makes the cost figure wrong by 25-100%."
    },
    {
      "type": "row",
      "title": "3. Cache (a semantic cache trades cost for silent correctness risk)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by cache outcome",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (cache_outcome) (rate(tierzero_request_cost_USD_count[$__rate_interval]))",
          "legendFormat": "{{cache_outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Hit rate",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(tierzero_request_cost_USD_count{cache_outcome!=\"miss\"}[$__rate_interval])) / sum(rate(tierzero_request_cost_USD_count[$__rate_interval]))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Production semantic-cache hit rates run 20-45%, not the ~95% vendors claim."
    },
    {
      "type": "timeseries",
      "title": "Degraded-path rate (an SLI in its own right)",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(tierzero_request_cost_USD_count{degraded=\"true\"}[$__rate_interval])) / sum(rate(tierzero_request_cost_USD_count[$__rate_interval]))",
          "legendFormat": "degraded",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "A system that is 99.9% successful while serving 40% degraded answers is not healthy."
    },
    {
      "type": "row",
      "title": "4. Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by tier",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (route_tier) (rate(tierzero_request_cost_USD_count[$__rate_interval]))",
          "legendFormat": "{{route_tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by tenant",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(tierzero_request_cost_USD_count[$__rate_interval]))",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "5. Vector store",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Qdrant collection size",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "collection_points",
          "legendFormat": "{{collection}} points",
          "refId": "A"
        },
        {
          "expr": "collection_vectors",
          "legendFormat": "{{collection}} vectors",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Verified against Qdrant's own /metrics output. The names here were wrong on the first pass -- a dashboard querying a metric that does not exist renders an empty panel, not an error."
    },
    {
      "type": "timeseries",
      "title": "Optimizer activity (the ingest/query contention signal)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "collection_running_optimizations",
          "legendFormat": "{{collection}} optimizing",
          "refId": "A"
        },
        {
          "expr": "cpu_cores_used",
          "legendFormat": "cpu cores used",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Qdrant's own measurements put search p50 at 780ms and p95 at 2.0s while segments drain. When this is non-zero, latency panels above are not steady state."
    }
  ]
}